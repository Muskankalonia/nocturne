# Nocturne page-capture worker.
#
# Deliberately a separate image from the crawler's Dockerfile. The crawler uses
# Debian's `chromium` package driven by Selenium; this worker uses Playwright,
# which pins its own browser build and refuses to drive an arbitrary system
# Chromium. Sharing one image would mean shipping two browsers and letting the
# crawler's apt pin decide whether captures work.
#
# Tor runs inside the container rather than beside it. A capture must never be
# taken over a direct connection — that would put the deployment's egress IP in
# an adversary's logs — and an in-container proxy makes that failure impossible
# to reach by misconfiguration rather than merely unlikely: there is no route to
# the onion service at all without it.
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        tor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Two requirements files, because the Snowflake driver lives only in the
# pipeline's. Installing just the root one produces an image that builds
# cleanly and dies on first run with ModuleNotFoundError: snowflake.connector.
COPY requirements.txt ./requirements.txt
COPY snowflake/requirements.txt ./requirements-snowflake.txt
RUN pip install --no-cache-dir \
      --requirement requirements.txt \
      --requirement requirements-snowflake.txt

# The base image ships the browsers, but the pip install above can resolve a
# different Playwright than the image was built against. This reconciles them.
RUN playwright install chromium

COPY scripts/capture_screenshots.py ./scripts/capture_screenshots.py

# Wait for Tor to finish bootstrapping, not merely to open its port.
#
# The worker's own guard checks that 127.0.0.1:9050 accepts a connection, and
# that happens roughly two minutes before Tor has enough directory information
# to build a circuit — measured on the first deployed run, where the port was
# ready at 05:33:50 and "Bootstrapped 100%" did not arrive until 05:35:57. A
# capture claimed inside that window is attempted over a Tor that cannot route
# it yet, and fails for a reason that has nothing to do with the page.
#
# Bounded at 180s: if Tor is still not up by then, start anyway and let the
# worker's guard produce its own clear error rather than hanging a container
# forever on a dependency that is never coming.
#
# tee keeps Tor's own notices on stdout, so Cloud Run still captures them.
CMD ["bash", "-c", "tor 2>&1 | tee /tmp/tor.log & waited=0; until grep -q 'Bootstrapped 100%' /tmp/tor.log 2>/dev/null || [ \"$waited\" -ge 180 ]; do sleep 1; waited=$((waited+1)); done; echo \"tor: ready after ${waited}s\"; exec python -u scripts/capture_screenshots.py --watch --interval 20"]
