/output/
/logs/
/export/
.env
.env.local

# Scratch files people paste credentials into while setting the project up.
# Anything matching these has held a live Snowflake token at some point.
don't_read_it.txt
temp.txt
*.env.txt

# Snowflake Node driver connection log — records account, user and role.
snowflake.log
.venv/
__pycache__/
*.pyc
output/report*.txt

# `scripts/render_diagrams.cjs` needs mermaid, which is installed with
# --no-save at the repo root. The rendered PNGs are committed; the toolchain
# that produced them is not.
node_modules/

# Hackathon submission material — decks, briefs, exported diagrams. Kept beside
# the code because that is where they get written, deliberately never pushed:
# they carry account identifiers and unredacted screenshots of live tenant data.
# Added after a `git add -A` swept three of them toward a public branch.
*.docx
*.pptx
architecture.pdf

# Firebase CLI debug log — records project id and deploy target.
firebase-debug.log

# Test coverage output
.coverage
coverage.xml
coverage.json
htmlcov/
.pytest_cache/

# GCP service account keys. nocturne-deployer.json is a live private key for
# the GitHub Actions deployer; one `git add -A` would publish it.
*-deployer.json
*-service-account*.json

# Data transfer scripts (contain account identifiers and auth tokens)
scripts/export_source.py
scripts/import_dest.py
scripts/load_all_data.py
scripts/gen_sql_batches.py
scripts/gen_remaining_ddls.py
scripts/gen_import_sql.py
scripts/transfer_data.py
