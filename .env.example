# Snowflake connection credentials
# Copy this to .env and fill in your values. NEVER commit .env to git.

SNOWFLAKE_ACCOUNT=HTMIFQX-DV35685
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# --- Auth Option 1: PAT (recommended, no password needed) ---
SNOWFLAKE_TOKEN=

# --- Auth Option 2: Username + Password ---
# SNOWFLAKE_USER=TARUGUPTA
# SNOWFLAKE_PASSWORD=your_password_here

# --- Breach alert dispatch ---
# After a successful run, deploy_pipeline.py asks the console to email any newly
# confirmed breaches. Idempotent: each incident/recipient pair is claimed before
# sending, so this can never produce duplicate mail. Leave blank to disable.
NOCTURNE_ALERT_DISPATCH_URL=https://nocturne-console.web.app/api/alerts/dispatch
NOCTURNE_ALERT_DISPATCH_TOKEN=

# --- Needs-review page captures (scripts/capture_screenshots.py) ---
# Bucket the Tor capture worker writes PNG captures to. Falls back to
# NOCTURNE_MANUAL_UPLOAD_BUCKET. Requires a local Tor SOCKS proxy — the same one
# the crawler uses — and `playwright install chromium`.
NOCTURNE_SCREENSHOT_BUCKET=
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
