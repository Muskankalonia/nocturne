# Trigger Email extension — non-secret configuration.
# Param names verified against firebase/firestore-send-email@0.2.10.

# MUST match the Firestore database's location, which is asia-southeast1.
# Pointing this at another region means the trigger never fires: the extension
# would watch a database that has no documents in it.
DATABASE=(default)
DATABASE_REGION=asia-southeast1
firebaseextensions.v1beta.function/location=asia-southeast1

# Must match the dashboard's FIREBASE_MAIL_COLLECTION.
MAIL_COLLECTION=mail

# Username + password over SMTP.
AUTH_TYPE=UsernamePassword
SMTP_CONNECTION_URI=smtps://nocturnesoc@gmail.com@smtp.gmail.com:465
OAUTH_PORT=465
OAUTH_SECURE=true

# Gmail rewrites or rejects a From that is not the authenticated account, so
# this has to be the same address as the SMTP user above. A domain you do not
# control (for example admin@nocturne.com) will not deliver.
DEFAULT_FROM=nocturnesoc@gmail.com
DEFAULT_REPLY_TO=

# A Secret Manager *reference*, never the password itself — that is how the CLI
# stores secret params, and it is why `ext:configure` never prompts for one in
# this local-manifest flow. Add the value with:
#   printf '%s' 'YOUR_APP_PASSWORD' | gcloud secrets versions add \
#     ext-firestore-send-email-SMTP_PASSWORD --data-file=- --project=nocturne-502617
SMTP_PASSWORD=projects/nocturne-502617/secrets/ext-firestore-send-email-SMTP_PASSWORD/versions/latest

# The app writes fully-rendered subject/text/html per document, so the
# extension's own Handlebars templates and user lookup stay off.
TEMPLATES_COLLECTION=
USERS_COLLECTION=

# Keep delivered mail documents; they are the audit trail of what was sent.
TTL_EXPIRE_TYPE=never
TTL_EXPIRE_VALUE=1
