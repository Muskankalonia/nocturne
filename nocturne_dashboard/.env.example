# Nocturne Console — server-side only. Never prefix with NEXT_PUBLIC_.
# Anything NEXT_PUBLIC_ is inlined into the browser bundle.

# Data source: "mock" (default) | "snapshot" | "live"
NOCTURNE_DATA_SOURCE=mock

# Mode "snapshot": directory or bucket holding exported JSON.
NOCTURNE_SNAPSHOT_DIR=./public/snapshots

# Mode "live" only. Warehouse cold starts bill per second — prefer snapshot.
# SNOWFLAKE_ACCOUNT=your-org-your-account
# SNOWFLAKE_USER=your-user
# SNOWFLAKE_TOKEN=your-programmatic-access-token
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=ACCOUNTADMIN
# SNOWFLAKE_DATABASE=NOCTURNE
