# Nocturne Console — live Snowflake backend.
# Copy this file to .env.local and fill in the authentication values:
#   cp .env.example .env.local
#
# Keep every Snowflake setting server-only. Variables prefixed NEXT_PUBLIC_ are
# embedded in the browser bundle and must never contain credentials.

NOCTURNE_DATA_SOURCE=live

# Signs the HttpOnly demo session used to enforce organization scope in API
# routes. Generate a value with: openssl rand -base64 48
NOCTURNE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Snowflake account identifier shown by SELECT CURRENT_ACCOUNT().
SNOWFLAKE_ACCOUNT=your-org-your-account
SNOWFLAKE_USER=your-dashboard-user

# Authentication option 1: programmatic access token (recommended here).
SNOWFLAKE_TOKEN=your-programmatic-access-token

# Authentication option 2: password. Leave this commented when using a token.
# SNOWFLAKE_PASSWORD=your-password

SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_DATABASE=NOCTURNE
SNOWFLAKE_SCHEMA=DASHBOARD

# Attribution and bounded failure behavior for read-only dashboard queries.
SNOWFLAKE_QUERY_TAG=NOCTURNE_DASHBOARD_READ
SNOWFLAKE_QUERY_TIMEOUT_SECONDS=30

# Safe to expose: the browser uses this only to schedule page refreshes.
# Five minutes matches the deterministic Snowflake table freshness targets.
NEXT_PUBLIC_DASHBOARD_REFRESH_MS=300000

# Perimeter allowlist enforced by src/middleware.ts on the deployed console.
# Both are comma-separated and both default to empty, which disables the check —
# leave them unset for local development. These gate who can reach the app; the
# signed session cookie still decides who can sign in and what they can see.
#
# Addresses accept CIDR notation, IPv4 or IPv6. Prefer a /64 for residential
# IPv6: privacy extensions rotate the host half of the address, often daily, so
# a pinned /128 stops matching overnight.
#
#   NOCTURNE_ALLOWED_IPS=203.0.113.7,2001:db8:1234:5678::/64
#   NOCTURNE_ALLOWED_HOSTS=nocturne-console-abc123-uc.a.run.app
NOCTURNE_ALLOWED_IPS=
NOCTURNE_ALLOWED_HOSTS=

# Number of trailing X-Forwarded-For hops contributed by a trusted proxy in
# front of the app. 0 for Cloud Run reached directly; 1 when Firebase Hosting
# proxies to it. Set wrong, the allowlist matches the proxy instead of the
# client and rejects everyone.
NOCTURNE_PROXY_HOPS=0

# Demo sign-in scheme: the password is the username plus this suffix, so with
# `_a1b2c3` the `admin` account signs in with `admin_a1b2c3`. Leave it empty
# for local development and the password is just the username.
#
# Never commit a real value. Once the console is reachable without an IP
# allowlist, a suffix in the repository is a published password.
NOCTURNE_DEMO_PASSWORD_SUFFIX=
